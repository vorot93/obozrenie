<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="libadwaita" version="1.5"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">About</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
  <object class="GtkStringList" id="secure_choices">
    <items>
      <item translatable="yes">(all)</item>
      <item translatable="yes">True</item>
      <item translatable="yes">False</item>
    </items>
  </object>
  <object class="GtkAdjustment" id="filter_ping_adjustment">
    <property name="upper">9999</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <template class="ObozrenieMainWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Obozrenie</property>
    <property name="default-width">1280</property>
    <property name="default-height">720</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkToggleButton" id="sidebar_toggle">
                <property name="icon-name">view-list-symbolic</property>
                <property name="active">True</property>
                <property name="tooltip-text" translatable="yes">Toggle game list view mode.</property>
                <signal name="toggled" handler="_on_sidebar_toggled"/>
              </object>
            </child>
            <child type="start">
              <object class="GtkRevealer" id="compact_game_revealer">
                <property name="transition-type">slide-right</property>
                <child>
                  <object class="GtkDropDown" id="compact_game_dropdown">
                    <property name="enable-search">True</property>
                    <property name="focusable">True</property>
                    <property name="tooltip-text" translatable="yes">Select a game.</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="preferences_button">
                <property name="icon-name">preferences-other-symbolic</property>
                <property name="tooltip-text" translatable="yes">Configure the selected game.</property>
                <signal name="clicked" handler="_on_preferences_clicked"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">primary_menu</property>
                <property name="primary">True</property>
                <property name="tooltip-text" translatable="yes">Main menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <child>
              <object class="GtkRevealer" id="sidebar_revealer">
                <property name="transition-type">slide-right</property>
                <property name="reveal-child">True</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="width-request">240</property>
                    <property name="margin-start">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkSearchEntry" id="game_search">
                        <property name="placeholder-text" translatable="yes">Search games</property>
                        <signal name="search-changed" handler="_on_game_search_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">True</property>
                        <property name="hscrollbar-policy">never</property>
                        <property name="has-frame">True</property>
                        <child>
                          <object class="GtkListView" id="game_list">
                            <property name="focusable">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="hexpand">True</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="GtkStack" id="pages">
                    <property name="vexpand">True</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">servers</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <property name="has-frame">True</property>
                            <child>
                              <object class="GtkColumnView" id="server_view">
                                <property name="focusable">True</property>
                                <signal name="activate" handler="_on_server_activated"/>
                                <child>
                                  <object class="GtkColumnViewColumn" id="name_column">
                                    <property name="title" translatable="yes">Name</property>
                                    <property name="expand">True</property>
                                    <property name="resizable">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="host_column">
                                    <property name="title" translatable="yes">Host</property>
                                    <property name="resizable">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="ping_column">
                                    <property name="title" translatable="yes">Ping</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="players_column">
                                    <property name="title" translatable="yes">Players</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="game_mod_column">
                                    <property name="title" translatable="yes">Game Mod</property>
                                    <property name="resizable">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="game_type_column">
                                    <property name="title" translatable="yes">Game Type</property>
                                    <property name="resizable">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="terrain_column">
                                    <property name="title" translatable="yes">Terrain</property>
                                    <property name="resizable">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">welcome</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="welcome_page">
                            <property name="icon-name">network-server-symbolic</property>
                            <property name="title" translatable="yes">Welcome to Obozrenie!</property>
                            <property name="description" translatable="yes">Select a game or press refresh button below.</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">loading</property>
                        <property name="child">
                          <object class="GtkSpinner" id="loading_spinner">
                            <property name="spinning">True</property>
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <property name="width-request">48</property>
                            <property name="height-request">48</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">error</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="error_page">
                            <property name="icon-name">dialog-error-symbolic</property>
                            <property name="title" translatable="yes">Oops. Something went wrong.</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkRevealer" id="filters_revealer">
                    <property name="transition-type">slide-up</property>
                    <child>
                      <object class="GtkGrid" id="filters_grid">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="filter_mod_label">
                            <property name="label" translatable="yes">_Game Mod:</property>
                            <property name="use-underline">True</property>
                            <property name="mnemonic-widget">filter_mod</property>
                            <property name="xalign">1</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="filter_mod">
                            <property name="hexpand">True</property>
                            <signal name="changed" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="filter_type_label">
                            <property name="label" translatable="yes">Game _Type:</property>
                            <property name="use-underline">True</property>
                            <property name="mnemonic-widget">filter_type</property>
                            <property name="xalign">1</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="filter_type">
                            <property name="hexpand">True</property>
                            <signal name="changed" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="filter_terrain_label">
                            <property name="label" translatable="yes">Te_rrain:</property>
                            <property name="use-underline">True</property>
                            <property name="mnemonic-widget">filter_terrain</property>
                            <property name="xalign">1</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="filter_terrain">
                            <property name="hexpand">True</property>
                            <signal name="changed" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="filter_ping_label">
                            <property name="label" translatable="yes">Max _ping:</property>
                            <property name="use-underline">True</property>
                            <property name="mnemonic-widget">filter_ping</property>
                            <property name="xalign">1</property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="filter_ping">
                            <property name="adjustment">filter_ping_adjustment</property>
                            <property name="numeric">True</property>
                            <signal name="value-changed" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="filter_secure_label">
                            <property name="label" translatable="yes">_Secure:</property>
                            <property name="use-underline">True</property>
                            <property name="mnemonic-widget">filter_secure</property>
                            <property name="xalign">1</property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkDropDown" id="filter_secure">
                            <property name="model">secure_choices</property>
                            <property name="focusable">True</property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="filter_notfull">
                            <property name="label" translatable="yes">Not full</property>
                            <signal name="toggled" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">4</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="filter_notempty">
                            <property name="label" translatable="yes">Has players</property>
                            <signal name="toggled" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">4</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="filter_nopassword">
                            <property name="label" translatable="yes">No password</property>
                            <signal name="toggled" handler="_on_filters_changed"/>
                            <layout>
                              <property name="column">4</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkActionBar" id="action_bar">
            <child type="start">
              <object class="GtkToggleButton" id="filters_toggle">
                <property name="icon-name">edit-find-symbolic</property>
                <property name="tooltip-text" translatable="yes">Set up server filters.</property>
                <signal name="toggled" handler="_on_filters_toggled"/>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="refresh_button">
                <property name="icon-name">view-refresh-symbolic</property>
                <property name="tooltip-text" translatable="yes">Update server list.</property>
                <signal name="clicked" handler="_on_refresh_clicked"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="connect_button">
                <property name="icon-name">network-server-symbolic</property>
                <property name="tooltip-text" translatable="yes">Connect to the selected server.</property>
                <signal name="clicked" handler="_on_connect_clicked"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="info_button">
                <property name="icon-name">dialog-information-symbolic</property>
                <property name="tooltip-text" translatable="yes">Show server information.</property>
                <signal name="clicked" handler="_on_info_clicked"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkPasswordEntry" id="password_entry">
                <property name="placeholder-text" translatable="yes">Password</property>
                <property name="tooltip-text" translatable="yes">The server password, if required.</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkEntry" id="host_entry">
                <property name="placeholder-text" translatable="yes">Host address</property>
                <property name="tooltip-text" translatable="yes">Server address to connect to. Automatically filled on changing server list selection.</property>
                <property name="input-purpose">url</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkDropDown" id="connect_game_dropdown">
                <property name="enable-search">True</property>
                <property name="focusable">True</property>
                <property name="tooltip-text" translatable="yes">Select a game.</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
